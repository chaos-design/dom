{
  "name": "@chaos-design/inspector",
  "type": "module",
  "version": "0.0.1",
  "description": "visualize the dom inspector",
  "exports": {
    "development": "./src/index.ts",
    "types": "./lib/index.d.ts",
    "require": "./lib/index.cjs.js",
    "import": "./lib/index.es.js"
  },
  "main": "./lib/index.cjs.js",
  "module": "./lib/index.es.js",
  "types": "./lib/index.d.ts",
  "files": ["lib", "index.d.ts"],
  "scripts": {
    "dev": "rm -rf lib && tsc && vite build --watch",
    "build": "rm -rf lib && tsc && vite build",
    "preinstall": "npx only-allow pnpm",
    "prepublish": "pnpm run build",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@ant-design/icons": "^6.3.4",
    "@chaos-design/css-selector": "workspace:*",
    "@emotion/css": "^11.13.5",
    "antd": "^6.6.5",
    "classnames": "^2.5.1",
    "mobx": "^7.0.5",
    "mobx-react-lite": "^5.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-shadow": "^20.6.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.3",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "prop-types": "^15.8.1",
    "typescript": "^5.9.0",
    "unbuild": "^3.6.1",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.2"
