{
  "name": "@chaos-design/css-selector",
  "type": "module",
  "version": "0.0.1",
  "description": "A tool for parsing and generating CSS selectors.",
  "exports": {
    "development": "./src/index.ts",
    "types": "./index.d.ts",
    "require": "./lib/index.cjs",
    "import": "./lib/index.js"
  },
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "types": "./index.d.ts",
  "files": ["lib", "index.d.ts"],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "preinstall": "npx only-allow pnpm",
    "prepublish": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "release": "bumpp package.json"
  },
  "dependencies": {
    "@chaos-design/dom-finder": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "bumpp": "^12.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "unbuild": "^3.6.1"
  }
}
